<ul>
   <% if current_user %>
   <li><%= link_to current_user.first_name, user_path(current_user) %></li>
   <li><%= link_to "Sign Out", session_path, data: {turbo_method: :delete} %></li>
   <% else %>
      <li><%= link_to "Sign In", new_session_path %></li>
      <li><%= link_to "Sign Up", new_user_path %></li>
   <% end %>
</ul>